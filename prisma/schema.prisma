generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model academic_calendars {
  id                 Int               @id @default(autoincrement())
  batch_id           Int
  semester           Int               @db.SmallInt
  start_date         DateTime          @db.Date
  end_date           DateTime          @db.Date
  created_by_user_id Int?
  batches            batches           @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?            @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calendar_events    calendar_events[]

  @@unique([batch_id, semester])
}

model achievement_comments {
  id                      Int                     @id @default(autoincrement())
  achievement_id          Int
  commented_by_user_id    Int
  comment_text            String
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  department_achievements department_achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                   users                   @relation(fields: [commented_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([achievement_id, created_at], map: "idx_achievement_comments_achievement")
}

model achievement_media {
  id                      Int                         @id @default(autoincrement())
  achievement_id          Int
  media_type              achievement_media_type_enum
  media_url               String                      @db.VarChar(500)
  thumbnail_url           String?                     @db.VarChar(500)
  sequence_no             Int                         @default(1) @db.SmallInt
  department_achievements department_achievements     @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([achievement_id, sequence_no])
}

model alumni_announcements {
  id                Int      @id @default(autoincrement())
  posted_by_user_id Int
  title             String   @db.VarChar(150)
  content           String
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  users             users    @relation(fields: [posted_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model alumni_batches {
  id                    Int                     @id @default(autoincrement())
  batch_id              Int                     @unique
  group_name            String                  @db.VarChar(150)
  graduated_on          DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  batches               batches                 @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alumni_group_messages alumni_group_messages[]
  alumni_members        alumni_members[]
}

model alumni_group_messages {
  id                         Int             @id @default(autoincrement())
  alumni_batch_id            Int
  posted_by_alumni_member_id Int?
  content                    String
  attachment_url             String?         @db.VarChar(500)
  created_at                 DateTime        @default(now()) @db.Timestamptz(6)
  posted_by_user_id          Int?
  alumni_batches             alumni_batches  @relation(fields: [alumni_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alumni_members             alumni_members? @relation(fields: [posted_by_alumni_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                      users?          @relation(fields: [posted_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([alumni_batch_id, created_at], map: "idx_alumni_group_messages_batch")
}

model alumni_members {
  id                    Int                       @id @default(autoincrement())
  alumni_batch_id       Int
  student_id            Int                       @unique
  personal_email        String?                   @db.Citext
  personal_phone        String?                   @db.VarChar(20)
  current_company       String?                   @db.VarChar(200)
  designation           String?                   @db.VarChar(150)
  status                alumni_member_status_enum @default(active)
  joined_at             DateTime                  @default(now()) @db.Timestamptz(6)
  alumni_group_messages alumni_group_messages[]
  alumni_batches        alumni_batches            @relation(fields: [alumni_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students              students                  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model announcement_class_mapping {
  id              Int           @id @default(autoincrement())
  announcement_id Int
  class_id        Int
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_announcement")
  classes         classes       @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_class")

  @@unique([announcement_id, class_id], map: "uq_announcement_class")
  @@index([class_id], map: "idx_announcement_class_mapping_class")
}

model announcement_role_mapping {
  id              Int           @id @default(autoincrement())
  announcement_id Int
  role_id         Int
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_announcement_role")
  roles           roles         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role")

  @@unique([announcement_id, role_id], map: "uq_announcement_role")
  @@index([role_id], map: "idx_announcement_role_mapping_role")
}

model announcements {
  id                         Int                          @id @default(autoincrement())
  posted_by_user_id          Int
  title                      String                       @db.VarChar(150)
  content                    String
  target_audience            target_audience_enum
  batch_id                   Int?
  department_id              Int?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  file_url                   String?
  file_name                  String?                      @db.VarChar(255)
  status                     announcement_status_enum     @default(published)
  file_key                   String?
  category                   announcement_category_enum?
  scheduled_at               DateTime?                    @db.Timestamptz(6)
  priority                   String?                      @db.VarChar(20)
  announcement_class_mapping announcement_class_mapping[]
  announcement_role_mapping  announcement_role_mapping[]
  batches                    batches?                     @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments                departments?                 @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                      users                        @relation(fields: [posted_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([target_audience, batch_id, department_id], map: "idx_announcements_target")
}

model appraisal_attachments {
  id                   Int                 @id @default(autoincrement())
  appraisal_request_id Int
  division_id          Int
  file_url             String              @db.VarChar(500)
  file_name            String              @db.VarChar(255)
  storage_path         String              @db.VarChar(500)
  uploaded_at          DateTime            @default(now()) @db.Timestamptz(6)
  appraisal_requests   appraisal_requests  @relation(fields: [appraisal_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appraisal_divisions  appraisal_divisions @relation(fields: [division_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appraisal_request_id, division_id], map: "idx_appraisal_attachments_request_division")
}

model appraisal_criteria {
  id                  Int                 @id @default(autoincrement())
  division_id         Int
  criteria_name       String              @db.VarChar(150)
  max_score           Decimal             @db.Decimal(6, 2)
  academic_year       String              @db.VarChar(20)
  weightage_percent   Decimal?            @db.Decimal(5, 2)
  created_by_user_id  Int?
  status              String              @default("active") @db.VarChar(10)
  users               users?              @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "appraisal_criteria_created_by_fkey")
  appraisal_divisions appraisal_divisions @relation(fields: [division_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appraisal_entries   appraisal_entries[]
}

model appraisal_divisions {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique @db.VarChar(100)
  appraisal_attachments appraisal_attachments[]
  appraisal_criteria    appraisal_criteria[]
}

model appraisal_entries {
  id                   Int                @id @default(autoincrement())
  appraisal_request_id Int
  criteria_id          Int
  description          String?
  score                Decimal?           @db.Decimal(6, 2)
  appraisal_requests   appraisal_requests @relation(fields: [appraisal_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appraisal_criteria   appraisal_criteria @relation(fields: [criteria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model appraisal_requests {
  id                                                     Int                     @id @default(autoincrement())
  faculty_id                                             Int?
  academic_year                                          String                  @db.VarChar(20)
  status                                                 appraisal_status_enum   @default(submitted)
  hod_reviewed_by                                        Int?
  hod_reviewed_at                                        DateTime?               @db.Timestamptz(6)
  management_approved_by                                 Int?
  management_approved_at                                 DateTime?               @db.Timestamptz(6)
  created_at                                             DateTime                @default(now()) @db.Timestamptz(6)
  hod_remarks                                            String?
  staff_user_id                                          Int?
  appraisal_attachments                                  appraisal_attachments[]
  appraisal_entries                                      appraisal_entries[]
  faculty                                                faculty?                @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appraisal_requests_hod_reviewed_byTousers        users?                  @relation("appraisal_requests_hod_reviewed_byTousers", fields: [hod_reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appraisal_requests_management_approved_byTousers users?                  @relation("appraisal_requests_management_approved_byTousers", fields: [management_approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appraisal_requests_staff_user_idTousers          users?                  @relation("appraisal_requests_staff_user_idTousers", fields: [staff_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignments {
  id                        Int                         @id @default(autoincrement())
  class_id                  Int
  subject_id                Int
  faculty_id                Int
  academic_year             String                      @db.VarChar(20)
  semester                  Int                         @db.SmallInt
  sequence_no               Int                         @db.SmallInt
  title                     String?                     @db.VarChar(200)
  description               String?                     @db.VarChar(2000)
  due_date                  DateTime?                   @db.Timestamptz(6)
  max_marks                 Int?
  task_type                 task_type_enum              @default(assignment)
  attachment_url            String?                     @db.VarChar(500)
  classes                   classes                     @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty                   faculty                     @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects                  subjects                    @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_assignment_status student_assignment_status[]

  @@unique([class_id, subject_id, academic_year, semester, sequence_no])
  @@index([class_id, subject_id, academic_year, semester], map: "idx_assignments_class_subject")
}

model attendance_records {
  id                   Int                    @id @default(autoincrement())
  student_id           Int
  class_id             Int
  subject_id           Int?
  attendance_date      DateTime               @db.Date
  status               attendance_status_enum
  marked_by_faculty_id Int?
  marked_by_user_id    Int
  is_published         Boolean                @default(true)
  published_at         DateTime?              @db.Timestamp(6)
  photo_url            String?                @db.VarChar(500)
  classes              classes                @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty              faculty?               @relation(fields: [marked_by_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects             subjects?              @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users                  @relation(fields: [marked_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_marked_by_user")
  students             students               @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_student")

  @@unique([student_id, class_id, subject_id, attendance_date])
  @@index([class_id, attendance_date], map: "idx_attendance_class_date")
  @@index([student_id, attendance_date], map: "idx_attendance_student_date")
  @@index([marked_by_user_id], map: "idx_attendance_marked_by_user")
}

model batches {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(50)
  start_year         Int                  @db.SmallInt
  end_year           Int                  @db.SmallInt
  academic_calendars academic_calendars[]
  alumni_batches     alumni_batches?
  announcements      announcements[]
  classes            classes[]
  exams              exams[]
  feedback_forms     feedback_forms[]
  project_teams      project_teams[]
  students           students[]
}

model bonafide_reasons {
  id                Int                 @id @default(autoincrement())
  reason_text       String              @unique @db.VarChar(255)
  bonafide_requests bonafide_requests[]
}

model bonafide_requests {
  id                     Int                  @id @default(autoincrement())
  student_id             Int
  reason_id              Int
  status                 bonafide_status_enum @default(pending)
  requested_at           DateTime             @default(now()) @db.Timestamptz(6)
  issued_at              DateTime?            @db.Timestamptz(6)
  file_url               String?              @db.VarChar(500)
  approved_by_faculty_id Int?
  issued_by_hod_user_id  Int?
  faculty                faculty?             @relation(fields: [approved_by_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?               @relation(fields: [issued_by_hod_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bonafide_reasons       bonafide_reasons     @relation(fields: [reason_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students               students             @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_bonafide_requests_status")
  @@index([student_id], map: "idx_bonafide_requests_student")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model book_borrow_records {
  id                                                                Int                @id @default(autoincrement())
  book_id                                                           Int
  borrower_type                                                     borrower_type_enum
  student_id                                                        Int?
  faculty_id                                                        Int?
  borrowed_date                                                     DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date                                                          DateTime           @db.Date
  returned_date                                                     DateTime?          @db.Date
  status                                                            borrow_status_enum @default(borrowed)
  renewal_count                                                     Int                @default(0) @db.SmallInt
  last_renewed_at                                                   DateTime?          @db.Timestamptz(6)
  damage_lost_charge_amount                                         Decimal?           @db.Decimal(10, 2)
  damage_lost_collected_by_user_id                                  Int?
  damage_lost_declared_at                                           DateTime?          @db.Timestamptz(6)
  damage_lost_settled                                               Boolean            @default(false)
  damage_lost_settled_at                                            DateTime?          @db.Timestamptz(6)
  fine_collected_by_user_id                                         Int?
  fine_paid                                                         Boolean            @default(false)
  fine_paid_amount                                                  Decimal?           @db.Decimal(10, 2)
  fine_paid_at                                                      DateTime?          @db.Timestamptz(6)
  replacement_indent_id                                             Int?               @unique
  staff_user_id                                                     Int?
  books                                                             books              @relation(fields: [book_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_book_borrow_records_damage_lost_collected_by_user_idTousers users?             @relation("book_borrow_records_damage_lost_collected_by_user_idTousers", fields: [damage_lost_collected_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty                                                           faculty?           @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_book_borrow_records_fine_collected_by_user_idTousers        users?             @relation("book_borrow_records_fine_collected_by_user_idTousers", fields: [fine_collected_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_indents                                                  purchase_indents?  @relation(fields: [replacement_indent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_book_borrow_records_staff_user_idTousers                    users?             @relation("book_borrow_records_staff_user_idTousers", fields: [staff_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                                                          students?          @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_book_borrow_status")
}

model book_categories {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(150)
  books       books[]
  e_resources e_resources[]
}

model books {
  id                  Int                   @id @default(autoincrement())
  qr_code             String                @unique @db.VarChar(100)
  title               String                @db.VarChar(255)
  author              String?               @db.VarChar(255)
  category_id         Int
  total_copies        Int                   @default(1)
  available_copies    Int                   @default(1)
  department_id       Int?
  edition             String?               @db.VarChar(50)
  isbn                String?               @db.VarChar(30)
  price_per_copy      Decimal?              @db.Decimal(10, 2)
  publisher           String?               @db.VarChar(255)
  vendor_fund         String?               @db.VarChar(255)
  rack_id             Int?
  deleted_at          DateTime?             @db.Timestamptz(6)
  book_borrow_records book_borrow_records[]
  book_categories     book_categories       @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments         departments?          @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  library_racks       library_racks?        @relation(fields: [rack_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bus_live_locations {
  id         Int      @id @default(autoincrement())
  bus_id     Int
  latitude   Decimal  @db.Decimal(10, 6)
  longitude  Decimal  @db.Decimal(10, 6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  buses      buses    @relation(fields: [bus_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model buses {
  id                        Int                         @id @default(autoincrement())
  route_id                  Int?
  vehicle_number            String                      @unique @db.VarChar(30)
  driver_name               String?                     @db.VarChar(150)
  gps_device_id             String?                     @db.VarChar(100)
  bus_no                    String                      @unique
  capacity                  Int?
  status                    String                      @default("in_depot") @db.VarChar(20)
  driver_phone              String?                     @db.VarChar(20)
  driver_licence_no         String?                     @db.VarChar(50)
  driver_licence_expiry     DateTime?                   @db.Date
  attendant_name            String?                     @db.VarChar(150)
  attendant_phone           String?                     @db.VarChar(20)
  odometer_km               Int?
  next_service_due_km       Int?
  last_service_date         DateTime?                   @db.Date
  model                     String?                     @db.VarChar(100)
  body_type                 String?                     @db.VarChar(100)
  year_of_manufacture       Int?                        @db.SmallInt
  fuel_emission             String?                     @db.VarChar(50)
  chassis_no                String?                     @db.VarChar(50)
  engine_no                 String?                     @db.VarChar(50)
  engine_spec               String?                     @db.VarChar(100)
  wheelbase_mm              Int?
  tyre_spec                 String?                     @db.VarChar(100)
  fuel_tank_litres          Int?
  ownership                 String?                     @db.VarChar(100)
  rto                       String?                     @db.VarChar(100)
  parking_bay               String?                     @db.VarChar(50)
  registered_date           DateTime?                   @db.Date
  driver_experience_years   Int?                        @db.SmallInt
  driver_blood_group        String?                     @db.VarChar(10)
  bus_documents             bus_documents[]
  bus_fuel_logs             bus_fuel_logs[]
  bus_live_locations        bus_live_locations[]
  bus_safety_checks         bus_safety_checks[]
  bus_service_logs          bus_service_logs[]
  transport_routes          transport_routes?           @relation(fields: [route_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_transport_mapping student_transport_mapping[]
}

model calendar_events {
  id                   Int                      @id(map: "calendar_holidays_pkey") @default(autoincrement())
  academic_calendar_id Int
  event_date           DateTime                 @db.Date
  description          String?                  @db.VarChar(255)
  event_type           calendar_event_type_enum @default(holiday)
  title                String                   @db.VarChar(200)
  start_time           DateTime?                @db.Time(6)
  end_time             DateTime?                @db.Time(6)
  created_by_user_id   Int?
  users                users?                   @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academic_calendars   academic_calendars       @relation(fields: [academic_calendar_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_holidays_academic_calendar_id_fkey")

  @@index([academic_calendar_id, event_date], map: "idx_calendar_events_calendar_date")
  @@index([event_type], map: "idx_calendar_events_type")
}

model certificate_types {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique @db.VarChar(150)
  student_certificates student_certificates[]
}

model class_mentors {
  id                  Int     @id @default(autoincrement())
  class_id            Int
  faculty_id          Int
  academic_year       String  @db.VarChar(20)
  assigned_by_user_id Int?
  users               users?  @relation(fields: [assigned_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classes             classes @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty             faculty @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([class_id, academic_year])
}

model class_subjects {
  id          Int      @id @default(autoincrement())
  class_id    Int
  subject_id  Int
  semester    Int      @db.SmallInt
  is_elective Boolean  @default(false)
  classes     classes  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects    subjects @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([class_id, subject_id, semester])
}

model classes {
  id                            Int                             @id @default(autoincrement())
  batch_id                      Int
  department_id                 Int
  course_id                     Int
  section                       String                          @db.VarChar(10)
  current_semester              Int?                            @db.SmallInt
  classroom                     String?                         @db.VarChar(50)
  announcement_class_mapping    announcement_class_mapping[]
  assignments                   assignments[]
  attendance_records            attendance_records[]
  class_mentors                 class_mentors[]
  class_subjects                class_subjects[]
  batches                       batches                         @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses                       courses                         @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments                   departments                     @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_subject_mapping          exam_subject_mapping[]
  faculty_subject_class_mapping faculty_subject_class_mapping[]
  feedback_assignments          feedback_assignments[]
  feedback_forms                feedback_forms[]
  lesson_plans                  lesson_plans[]
  lms_folder_classes            lms_folder_classes[]
  lms_notes                     lms_notes[]
  project_teams                 project_teams[]
  students                      students[]
  timetable_slots               timetable_slots[]

  @@unique([batch_id, course_id, section])
}

model companies {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(200)
  profile_info     String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  placement_drives placement_drives[]
}

model coordinator_calendar_entries {
  id            Int                                  @id @default(autoincrement())
  academic_year String                               @db.VarChar(20)
  semester      Int?                                 @db.SmallInt
  entry_date    DateTime                             @db.Date
  entry_type    coordinator_calendar_entry_type_enum
  title         String                               @db.VarChar(200)
  created_at    DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                             @default(now()) @db.Timestamptz(6)

  @@index([entry_date], map: "idx_coordinator_calendar_entries_date")
  @@index([academic_year, semester], map: "idx_coordinator_calendar_entries_year_semester")
}

model courses {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(150)
  code           String      @unique @db.VarChar(30)
  department_id  Int
  duration_years Int         @default(4) @db.SmallInt
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  classes        classes[]
  departments    departments @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students       students[]
}

model demand_categories {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @unique @db.VarChar(100)
  fee_structure_items        fee_structure_items[]
  student_fee_demand_mapping student_fee_demand_mapping[]
}

model department_achievements {
  id                   Int                    @id @default(autoincrement())
  department_id        Int
  posted_by_user_id    Int
  title                String                 @db.VarChar(200)
  description          String?
  achievement_date     DateTime?              @db.Date
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  achievement_comments achievement_comments[]
  achievement_media    achievement_media[]
  departments          departments            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users                  @relation(fields: [posted_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model departments {
  id                                                         Int                              @id @default(autoincrement())
  name                                                       String                           @db.VarChar(150)
  code                                                       String                           @unique @db.VarChar(20)
  created_at                                                 DateTime                         @default(now()) @db.Timestamptz(6)
  head_of_department_faculty_id                              Int?
  announcements                                              announcements[]
  books                                                      books[]
  classes                                                    classes[]
  courses                                                    courses[]
  curriculum_mappings                                        curriculum_mappings[]
  department_achievements                                    department_achievements[]
  department_documents                                       department_documents[]
  department_events                                          department_events[]
  department_meetings                                        department_meetings[]
  faculty_departments_head_of_department_faculty_idTofaculty faculty?                         @relation("departments_head_of_department_faculty_idTofaculty", fields: [head_of_department_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "departments_hod_fkey")
  exam_timetable_versions                                    exam_timetable_versions[]
  faculty_faculty_department_idTodepartments                 faculty[]                        @relation("faculty_department_idTodepartments")
  feedback_assignments                                       feedback_assignments[]
  marks_entry_locks                                          marks_entry_locks[]
  nba_criteria                                               nba_criteria[]
  non_teaching_staff                                         non_teaching_staff[]
  od_request_hod_approvals                                   od_request_hod_approvals[]
  project_teams                                              project_teams[]
  purchase_indents                                           purchase_indents[]
  seating_plan_venue_departments                             seating_plan_venue_departments[]
  service_indents                                            service_indents[]
  sports_teams                                               sports_teams[]
  subjects                                                   subjects[]
}

model e_resources {
  id                  Int              @id @default(autoincrement())
  title               String           @db.VarChar(255)
  url                 String           @db.VarChar(500)
  category_id         Int?
  concurrent_seats    Int?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  file_size_bytes     Int?
  format              String?          @db.VarChar(20)
  license_type        String?          @db.VarChar(50)
  pages               Int?
  publish_state       String           @default("draft") @db.VarChar(20)
  uploaded_by_user_id Int?
  book_categories     book_categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?           @relation(fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model education_loan_dd {
  id                            Int                        @id @default(autoincrement())
  student_fee_demand_mapping_id Int
  dd_reference_number           String                     @unique @db.VarChar(50)
  bank_name                     String                     @db.VarChar(150)
  amount                        Decimal                    @db.Decimal(12, 2)
  status                        dd_status_enum             @default(received)
  acknowledgement_receipt_no    String?                    @db.VarChar(50)
  received_by_user_id           Int?
  created_at                    DateTime                   @default(now()) @db.Timestamptz(6)
  users                         users?                     @relation(fields: [received_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_fee_demand_mapping    student_fee_demand_mapping @relation(fields: [student_fee_demand_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model exam_marks {
  id                      Int                    @id @default(autoincrement())
  exam_subject_mapping_id Int
  student_id              Int
  marks_obtained          Decimal?               @db.Decimal(6, 2)
  max_marks               Decimal                @db.Decimal(6, 2)
  entered_by_faculty_id   Int?
  entered_at              DateTime               @default(now()) @db.Timestamptz(6)
  is_absent               Boolean                @default(false)
  is_moderated            Boolean                @default(false)
  faculty                 faculty?               @relation(fields: [entered_by_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_subject_mapping    exam_subject_mapping   @relation(fields: [exam_subject_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                students               @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  photocopy_requests      photocopy_requests[]
  revaluation_requests    revaluation_requests[]

  @@unique([exam_subject_mapping_id, student_id])
  @@index([exam_subject_mapping_id], map: "idx_exam_marks_mapping")
  @@index([student_id], map: "idx_exam_marks_student")
}

model exam_subject_mapping {
  id                    Int                     @id @default(autoincrement())
  exam_id               Int
  class_id              Int
  subject_id            Int
  is_published          Boolean                 @default(false)
  published_at          DateTime?               @db.Timestamptz(6)
  is_elective           Boolean                 @default(false)
  exam_marks            exam_marks[]
  classes               classes                 @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exams                 exams                   @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects              subjects                @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_timetable        exam_timetable[]
  malpractice_incidents malpractice_incidents[]

  @@unique([exam_id, class_id, subject_id])
}

model exam_timetable {
  id                      Int                     @id @default(autoincrement())
  exam_subject_mapping_id Int
  exam_date               DateTime                @db.Date
  start_time              DateTime                @db.Time(6)
  end_time                DateTime                @db.Time(6)
  version_id              Int
  session                 exam_session_enum
  venue_id                Int?
  exam_subject_mapping    exam_subject_mapping    @relation(fields: [exam_subject_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues                  venues?                 @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_timetable_versions exam_timetable_versions @relation(fields: [version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([version_id, exam_subject_mapping_id])
}

model exam_types {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique @db.VarChar(50)
  category      exam_type_category_enum @default(external)
  code          String?                 @unique @db.VarChar(20)
  is_university Boolean                 @default(true)
  exams         exams[]
}

model exams {
  id                               Int                                @id @default(autoincrement())
  exam_type_id                     Int
  batch_id                         Int
  academic_year                    String                             @db.VarChar(20)
  semester                         Int                                @db.SmallInt
  status                           exam_status_enum                   @default(created)
  created_by_user_id               Int?
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  end_date                         DateTime?                          @db.Date
  start_date                       DateTime?                          @db.Date
  title                            String?                            @db.VarChar(200)
  exam_subject_mapping             exam_subject_mapping[]
  exam_timetable_versions          exam_timetable_versions[]
  batches                          batches                            @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                            users?                             @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_types                       exam_types                         @relation(fields: [exam_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hall_plans                       hall_plans[]
  hall_ticket_clearance_exceptions hall_ticket_clearance_exceptions[]
  hall_tickets                     hall_tickets[]
  invigilation_allocation_batches  invigilation_allocation_batches[]
  invigilation_duties              invigilation_duties[]
  malpractice_incidents            malpractice_incidents[]
  marks_entry_locks                marks_entry_locks[]
  marksheets                       marksheets[]
  result_publications              result_publications[]
  revaluation_requests             revaluation_requests[]
  revaluation_windows              revaluation_windows?
  seating_plan_versions            seating_plan_versions[]
}

model expense_categories {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(100)
  expenses expenses[]
}

model expenses {
  id                  Int                @id @default(autoincrement())
  category_id         Int
  description         String?            @db.VarChar(255)
  amount              Decimal            @db.Decimal(12, 2)
  expense_date        DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  recorded_by_user_id Int?
  expense_categories  expense_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?             @relation(fields: [recorded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category_id, expense_date], map: "idx_expenses_category_date")
}

model faculty {
  id                                                                                         Int                              @id @default(autoincrement())
  user_id                                                                                    Int                              @unique
  first_name                                                                                 String                           @db.VarChar(100)
  last_name                                                                                  String                           @db.VarChar(100)
  designation                                                                                String                           @db.VarChar(100)
  department_id                                                                              Int
  date_of_joining                                                                            DateTime?                        @db.Date
  status                                                                                     user_status_enum                 @default(active)
  created_at                                                                                 DateTime                         @default(now()) @db.Timestamptz(6)
  profile_url                                                                                String?
  is_mentor                                                                                  Boolean                          @default(false)
  phone_verified                                                                             Boolean                          @default(false)
  whatsapp_verified                                                                          Boolean                          @default(false)
  prefix                                                                                     String?                          @db.VarChar(10)
  gender                                                                                     String?                          @db.VarChar(20)
  date_of_birth                                                                              DateTime?                        @db.Date
  personal_email                                                                             String?                          @db.VarChar(255)
  whatsapp_number                                                                            String?                          @db.VarChar(20)
  alternate_phone                                                                            String?                          @db.VarChar(20)
  address_line                                                                               String?                          @db.VarChar(255)
  city                                                                                       String?                          @db.VarChar(100)
  state                                                                                      String?                          @db.VarChar(100)
  postal_code                                                                                String?                          @db.VarChar(10)
  academic_role                                                                              String?                          @db.VarChar(50)
  employment_status                                                                          faculty_employment_status_enum?
  employment_type                                                                            faculty_employment_type_enum?
  confirmation_date                                                                          DateTime?                        @db.Date
  probation_end_date                                                                         DateTime?                        @db.Date
  work_location                                                                              String?                          @db.VarChar(255)
  qualification                                                                              String?                          @db.VarChar(100)
  specialization                                                                             String?                          @db.VarChar(255)
  previous_institution                                                                       String?                          @db.VarChar(255)
  previous_experience_years                                                                  Int?
  office_room                                                                                String?                          @db.VarChar(100)
  reports_to_faculty_id                                                                      Int?
  resume_url                                                                                 String?                          @db.VarChar(500)
  designation_id                                                                             Int?
  appraisal_requests                                                                         appraisal_requests[]
  assignments                                                                                assignments[]
  attendance_records                                                                         attendance_records[]
  bonafide_requests                                                                          bonafide_requests[]
  book_borrow_records                                                                        book_borrow_records[]
  campus_outing_requests                                                                     campus_outing_requests[]
  class_mentors                                                                              class_mentors[]
  department_events                                                                          department_events[]
  departments_departments_head_of_department_faculty_idTofaculty                             departments[]                    @relation("departments_head_of_department_faculty_idTofaculty")
  exam_marks                                                                                 exam_marks[]
  departments                                                                                departments                      @relation("faculty_department_idTodepartments", fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designations                                                                               designations?                    @relation(fields: [designation_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "faculty_designation_fkey")
  faculty                                                                                    faculty?                         @relation("facultyTofaculty", fields: [reports_to_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_faculty                                                                              faculty[]                        @relation("facultyTofaculty")
  users                                                                                      users                            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty_activity_log                                                                       faculty_activity_log[]
  faculty_attendance_corrections                                                             faculty_attendance_corrections[]
  faculty_daily_attendance                                                                   faculty_daily_attendance[]
  faculty_documents                                                                          faculty_documents[]
  faculty_holiday_mapping                                                                    faculty_holiday_mapping[]
  faculty_hostel_mapping                                                                     faculty_hostel_mapping?
  faculty_id_card_issuances                                                                  faculty_id_card_issuances[]
  faculty_leave_balances                                                                     faculty_leave_balances[]
  faculty_leaves                                                                             faculty_leaves[]
  faculty_od_requests                                                                        faculty_od_requests[]
  faculty_sensitive_info                                                                     faculty_sensitive_info?
  faculty_subject_class_mapping                                                              faculty_subject_class_mapping[]
  faculty_subject_class_mapping_faculty_subject_class_mapping_substitute_faculty_idTofaculty faculty_subject_class_mapping[]  @relation("faculty_subject_class_mapping_substitute_faculty_idTofaculty")
  hr_queries                                                                                 hr_queries[]
  incubations                                                                                incubations[]
  invigilation_duties                                                                        invigilation_duties[]
  lesson_plans                                                                               lesson_plans[]
  lms_folders                                                                                lms_folders[]
  lms_notes                                                                                  lms_notes[]
  malpractice_incidents                                                                      malpractice_incidents[]
  media_requests                                                                             media_requests[]
  medical_visits                                                                             medical_visits[]
  od_requests                                                                                od_requests[]
  od_teams                                                                                   od_teams[]
  payslip_requests                                                                           payslip_requests[]
  revaluation_requests                                                                       revaluation_requests[]
  salary_divisions                                                                           salary_divisions[]
  salary_payments                                                                            salary_payments[]
  sports_coach_profiles                                                                      sports_coach_profiles?
  sports_disciplines                                                                         sports_disciplines[]
  sports_equipment_issues                                                                    sports_equipment_issues[]
  sports_od_requests                                                                         sports_od_requests[]
  sports_teams                                                                               sports_teams[]
  sports_training_sessions                                                                   sports_training_sessions[]
  startup_ideas                                                                              startup_ideas[]
  student_assignment_status                                                                  student_assignment_status[]
  student_entrepreneurship                                                                   student_entrepreneurship[]
  student_leaves                                                                             student_leaves[]
  student_projects                                                                           student_projects[]
  students                                                                                   students[]
  timetable_slots                                                                            timetable_slots[]

  @@index([department_id], map: "idx_faculty_department")
}

model faculty_holiday_mapping {
  id              Int           @id @default(autoincrement())
  faculty_id      Int
  holiday_slot_id Int
  faculty         faculty       @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  holiday_slots   holiday_slots @relation(fields: [holiday_slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([faculty_id, holiday_slot_id])
}

model faculty_leaves {
  id                                                       Int                   @id @default(autoincrement())
  faculty_id                                               Int?
  from_date                                                DateTime              @db.Date
  to_date                                                  DateTime              @db.Date
  reason                                                   String?               @db.VarChar(255)
  hod_approval_status                                      approval_status_enum  @default(pending)
  hr_approval_status                                       approval_status_enum  @default(pending)
  created_at                                               DateTime              @default(now()) @db.Timestamptz(6)
  leave_type_id                                            Int?
  hod_remarks                                              String?               @db.VarChar(255)
  hr_remarks                                               String?               @db.VarChar(255)
  hod_decided_at                                           DateTime?             @db.Timestamptz(6)
  hr_decided_at                                            DateTime?             @db.Timestamptz(6)
  hod_decided_by_user_id                                   Int?
  hr_decided_by_user_id                                    Int?
  attachment_url                                           String?               @db.VarChar(500)
  principal_approval_status                                approval_status_enum? @default(pending)
  principal_decided_by_user_id                             Int?
  principal_decided_at                                     DateTime?             @db.Timestamptz(6)
  principal_remarks                                        String?               @db.VarChar(255)
  alternate_arrangement                                    String?               @db.VarChar(255)
  is_station_leave                                         Boolean               @default(false)
  staff_user_id                                            Int?
  faculty                                                  faculty?              @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_faculty_leaves_hod_decided_by_user_idTousers       users?                @relation("faculty_leaves_hod_decided_by_user_idTousers", fields: [hod_decided_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "faculty_leaves_hod_decider_fkey")
  users_faculty_leaves_hr_decided_by_user_idTousers        users?                @relation("faculty_leaves_hr_decided_by_user_idTousers", fields: [hr_decided_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "faculty_leaves_hr_decider_fkey")
  leave_types                                              leave_types?          @relation(fields: [leave_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "faculty_leaves_leave_type_fkey")
  users_faculty_leaves_principal_decided_by_user_idTousers users?                @relation("faculty_leaves_principal_decided_by_user_idTousers", fields: [principal_decided_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_faculty_leaves_staff_user_idTousers                users?                @relation("faculty_leaves_staff_user_idTousers", fields: [staff_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model faculty_sensitive_info {
  id                  Int     @id @default(autoincrement())
  faculty_id          Int     @unique
  aadhar_number       String? @db.VarChar(20)
  pan_number          String? @db.VarChar(20)
  bank_account_number String? @db.VarChar(40)
  bank_ifsc           String? @db.VarChar(20)
  bank_name           String? @db.VarChar(100)
  faculty             faculty @relation(fields: [faculty_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model faculty_subject_class_mapping {
  id                                                                   Int                          @id @default(autoincrement())
  faculty_id                                                           Int
  subject_id                                                           Int
  class_id                                                             Int
  academic_year                                                        String                       @db.VarChar(20)
  assigned_by_user_id                                                  Int?
  substitute_faculty_id                                                Int?
  users                                                                users?                       @relation(fields: [assigned_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classes                                                              classes                      @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty                                                              faculty                      @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects                                                             subjects                     @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty_faculty_subject_class_mapping_substitute_faculty_idTofaculty faculty?                     @relation("faculty_subject_class_mapping_substitute_faculty_idTofaculty", fields: [substitute_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feedback_faculty_responses                                           feedback_faculty_responses[]

  @@unique([subject_id, class_id, academic_year])
}

model fee_concessions {
  id                Int            @id @default(autoincrement())
  fee_structure_id  Int
  concession_amount Decimal        @db.Decimal(12, 2)
  is_settled        Boolean        @default(false)
  settled_date      DateTime?      @db.Date
  fee_structures    fee_structures @relation(fields: [fee_structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model fee_payments {
  id                            Int                           @id @default(autoincrement())
  student_fee_demand_mapping_id Int
  amount_paid                   Decimal                       @db.Decimal(12, 2)
  payment_date                  DateTime                      @default(dbgenerated("CURRENT_DATE")) @db.Date
  payment_mode                  payment_mode_enum?
  receipt_no                    String                        @unique @db.VarChar(50)
  is_partial                    Boolean                       @default(false)
  collected_by_user_id          Int?
  created_at                    DateTime                      @default(now()) @db.Timestamptz(6)
  fee_structure_item_id         Int?
  fee_payment_gateway_orders    fee_payment_gateway_orders[]
  users                         users?                        @relation(fields: [collected_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fee_structure_items           fee_structure_items?          @relation(fields: [fee_structure_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_fee_demand_mapping    student_fee_demand_mapping    @relation(fields: [student_fee_demand_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fee_receipt_number_payments   fee_receipt_number_payments[]

  @@index([student_fee_demand_mapping_id], map: "idx_fee_payments_demand")
  @@index([fee_structure_item_id], map: "idx_fee_payments_fee_structure_item")
}

model fee_receipt_number_payments {
  receipt_number_id   Int
  fee_payment_id      Int
  fee_payments        fee_payments        @relation(fields: [fee_payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fee_receipt_numbers fee_receipt_numbers @relation(fields: [receipt_number_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([receipt_number_id, fee_payment_id])
}

model fee_receipt_numbers {
  id                          Int                           @id @default(autoincrement())
  print_date                  DateTime                      @db.Date
  issued_by_user_id           Int?
  issued_at                   DateTime                      @default(now()) @db.Timestamptz(6)
  fee_receipt_number_payments fee_receipt_number_payments[]
  users                       users?                        @relation(fields: [issued_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model fee_structure_items {
  id                  Int                @id @default(autoincrement())
  fee_structure_id    Int
  demand_category_id  Int?
  amount              Decimal            @db.Decimal(12, 2)
  hostel_room_type_id Int?
  transport_stage_id  Int?
  fee_payments        fee_payments[]
  demand_categories   demand_categories? @relation(fields: [demand_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
