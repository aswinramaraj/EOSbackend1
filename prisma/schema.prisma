/// *
/// * One row per (question, student, faculty-subject-class mapping) — the
/// * matrix cell for an end-semester feedback form: rows are the faculty
/// * mapped to the student's class (faculty_subject_class_mapping), columns
/// * are the form's questions. faculty_id/subject_id are a denormalized
/// * snapshot of the mapping at submission time (no FK — the mapping itself
/// * already carries them; kept here so a later faculty re-mapping can't
/// * retroactively change what a past response was actually about).
model feedback_faculty_responses {
  id                            Int                           @id @default(autoincrement())
  question_id                   Int
  student_id                    Int
  mapping_id                    Int
  faculty_id                    Int
  subject_id                    Int
  response_text                 String?
  rating_value                  Int?                          @db.SmallInt
  submitted_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  faculty_subject_class_mapping faculty_subject_class_mapping @relation(fields: [mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feedback_questions            feedback_questions            @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                      students                      @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([question_id, student_id, mapping_id], map: "feedback_faculty_responses_question_id_student_id_mapping_id_ke")
}

