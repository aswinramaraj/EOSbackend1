# ─────────────────────────────────────────────
# EOS Backend – Environment Variables Template
# Copy this file to .env locally, or paste each
# line into Render → your service → Environment,
# then replace every placeholder with a real value.
# ─────────────────────────────────────────────

# ══════════════════════════════════════════════
# REQUIRED — app fails to boot without these
# ══════════════════════════════════════════════

# Postgres connection string (Supabase pooler). PrismaService connects to
# this on startup — an invalid/missing value crashes the app immediately.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Signs/verifies JWTs. main.ts refuses to start at all if this is unset.
JWT_SECRET="replace_with_a_long_random_secret_key"

# Supabase project used for file storage (service-role key bypasses
# Storage RLS — never expose this to the frontend). SupabaseStorageProvider
# is instantiated eagerly at boot, so both of these are required even if no
# upload feature has been touched yet.
SUPABASE_URL="https://<your-project-id>.supabase.co"
SUPABASE_SERVICE_KEY="<your-service-role-key>"

# Supabase Storage's S3-compatible endpoint (Project Settings → Storage →
# S3 Connection). Backs the generic file-storage service used by
# announcements, students, profile, LMS, secretary documents, etc. — also
# instantiated eagerly, so required at boot.
SUPABASE_S3_ENDPOINT="https://<your-project-id>.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-south-1"
SUPABASE_S3_ACCESS_KEY_ID="<s3-access-key-id>"
SUPABASE_S3_SECRET_ACCESS_KEY="<s3-secret-access-key>"
SUPABASE_S3_BUCKET="<bucket-name>"

# ══════════════════════════════════════════════
# REQUIRED PER FEATURE — validated lazily, so the
# app still boots without these, but the matching
# feature returns a 500 until they're set
# ══════════════════════════════════════════════

# Bucket for the older, single-bucket storage path (appraisal attachments,
# faculty OD, me-od-attachments).
SUPABASE_STORAGE_BUCKET="appraisal-attachments"

# Razorpay — fee payments, wallet top-ups.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio Verify — phone OTP for faculty verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Attendance-CV service — face enrollment / recognition.
ATTENDANCE_CV_API_KEY=
ATTENDANCE_CV_BASE_URL=

# Cloudinary — attendance evidence photos only (CloudinaryStorageProvider).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════
# OPTIONAL — have safe defaults in code
# ══════════════════════════════════════════════

# Render/most hosts inject PORT automatically — do not set this manually
# in production. Only used for local dev if you want a non-default port.
PORT=3001

# Used by configuration.ts; not required, informational only.
NODE_ENV=development

# JWT lifetime. Defaults to "8h" in code if unset.
JWT_EXPIRES_IN="8h"

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to "*" (all origins) if unset — fine for local dev, but set this
# to your real deployed frontend URL(s) in production.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
